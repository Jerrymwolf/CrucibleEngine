          "options": [
            "accept-all",
            "accept-limited",
            "refuse-capacity",
            "refuse-resources"
          ]
        },
        {
          "id": "coordination-request",
          "name": "Coordination Request",
          "prompt": "Request joint operation with another parish",
          "requiresTarget": true,
          "options": [
            "joint-rescue",
            "shared-shelter",
            "supply-convoy",
            "communication-relay"
          ]
        }
      ]
    },
    "EVACUATION": {
      "id": "evacuation",
