            "request-generators",
            "offer-generators",
            "request-medical",
            "offer-medical",
            "request-fuel",
            "offer-fuel"
          ]
        },
        {
          "id": "evacuation-acceptance",
          "name": "Evacuation Acceptance",
          "prompt": "Accept evacuees from another parish?",
