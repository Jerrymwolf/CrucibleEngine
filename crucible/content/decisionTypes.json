        {
          "id": "evacuation-route",
          "name": "Evacuation Route",
          "prompt": "Which routes should evacuees use?",
          "options": [
            "primary-highway",
            "secondary-roads",
            "split-traffic",
            "contraflow"
          ]
        }
      ]
