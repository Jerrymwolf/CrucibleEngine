# =============================================================================
# CrucibleEngine Docker Environment Variables
# Copy to .env.docker and fill in your values
# =============================================================================

# Database (required)
DATABASE_URL=postgresql://crucible:crucible_dev_password@postgres:5432/crucible

# AI (required for narrative generation)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Clerk Authentication (required)
# Get these from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_JWKS_URL=https://YOUR_DOMAIN.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://YOUR_DOMAIN.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_...

# Next.js Public Variables
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_COLYSEUS_URL=ws://localhost:2567

# Optional: Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# Optional: Port configuration
COLYSEUS_PORT=2567
