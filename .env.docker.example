# CrucibleEngine Docker Environment
# Copy to .env.docker and fill in values

# Database (required)
POSTGRES_PASSWORD=your_secure_password_here

# AI API (required for AI features)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# URLs (adjust for production)
NEXT_PUBLIC_COLYSEUS_URL=ws://localhost:2567
NEXT_PUBLIC_APP_URL=http://localhost:3210

# Docker project name
COMPOSE_PROJECT_NAME=crucible
