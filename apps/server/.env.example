# =============================================================================
# CrucibleEngine Server Environment Variables
# =============================================================================

# Database
DATABASE_URL="postgresql://crucible:crucible_dev_password@localhost:5433/crucible"

# =============================================================================
# Clerk Authentication (for CM users)
# =============================================================================

# JWKS URL for JWT verification
# Get from: Clerk Dashboard > API Keys > Advanced > JWKS URL
CLERK_JWKS_URL=https://YOUR_CLERK_DOMAIN/.well-known/jwks.json

# Clerk issuer for JWT validation
# Get from: Clerk Dashboard > API Keys > Frontend API (e.g., https://clerk.your-app.com)
CLERK_ISSUER=https://YOUR_CLERK_DOMAIN

# =============================================================================
# Rate Limiting
# =============================================================================

# Auth rate limit: max attempts per window
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000

# Message rate limit: max messages per window
RATE_LIMIT_MESSAGE_MAX=100
RATE_LIMIT_MESSAGE_WINDOW_MS=60000

# =============================================================================
# Session Codes
# =============================================================================

# Session code length (default: 8)
SESSION_CODE_LENGTH=8

# Characters used in session codes (excludes ambiguous: 0, O, 1, I, L)
SESSION_CODE_CHARSET=ABCDEFGHJKLMNPQRSTUVWXYZ23456789

# =============================================================================
# AI Agents (Optional)
# =============================================================================

# Anthropic API key for narrative agent
ANTHROPIC_API_KEY=sk-ant-xxx

# Model to use (default: claude-sonnet-4-5-20250929)
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
