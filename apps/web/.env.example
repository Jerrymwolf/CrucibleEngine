# ============================================================================
# Crucible Engine - Web App Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in the values

# Colyseus Server
NEXT_PUBLIC_COLYSEUS_URL=ws://localhost:2567

# ============================================================================
# Clerk Authentication
# Get these from https://dashboard.clerk.com
# ============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Webhook secret for syncing users to database
# Get this from Clerk Dashboard > Webhooks
CLERK_WEBHOOK_SECRET=whsec_xxx

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/cm
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/cm

# ============================================================================
# Database (Prisma)
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/crucible

# ============================================================================
# AI Services (Optional - for AI Team Controller)
# ============================================================================
# ANTHROPIC_API_KEY=sk-ant-xxx
